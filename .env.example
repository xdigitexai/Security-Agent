NODE_ENV=development
DATABASE_URL=postgresql://xdigitex:xdigitex@postgres:5432/xdigitex_security?schema=public
REDIS_URL=redis://redis:6379
SESSION_SECRET=replace-with-at-least-32-random-bytes
APP_URL=http://localhost:3000
# Optional. Must resolve to localhost/127.0.0.1/::1 on the worker host.
# The broker receives only a credentialRef and returns a prepared request-header profile.
IDENTITY_PROFILE_BROKER_URL=http://127.0.0.1:4025
WORKER_CONCURRENCY=2
MAX_SCAN_DURATION_MS=1800000
MAX_PAGES=500
MAX_REQUESTS=5000
MAX_RESPONSE_SIZE=5242880
MAX_CONCURRENT_REQUESTS=5
MAX_REQUESTS_PER_SECOND=5
SCAN_USER_AGENT=Xdigitex-Security-Agent/0.2 (+authorized-security-testing)
TEST_TARGET_URL=http://test-target:4010
